# Postgres (Railway: ${{Postgres.DATABASE_URL}}).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medbase

# Passwort des ersten Kontos „admin“ (mindestens 12 Zeichen); wird nur bei leerer Benutzertabelle verwendet.
MEDBASE_ADMIN_PASSWORD=

# Bilder im S3-kompatiblen Bucket (Railway Bucket). Ohne diese Werte liegen Bilder in der Datenbank.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Optional: andere Adresse der Swissmedic-Liste „Zugelassene Packungen“ (Excel).
SWISSMEDIC_PACKAGES_URL=
# Optional: false = keine Beispieldaten in einer leeren Datenbank anlegen.
MEDBASE_SEED_EXAMPLES=true
